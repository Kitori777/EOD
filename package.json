{
  "name": "eyes-of-odin",
  "version": "0.1.0",
  "private": true,
  "description": "Lokalne studio wizualizacji danych, limitów i scenariuszy what-if.",
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --config vite.desktop.config.ts --port 1420",
    "build": "vite build --config vite.desktop.config.ts",
    "start": "vite preview --config vite.desktop.config.ts --port 1420",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests vite.desktop.config.ts eslint.config.mjs",
    "test:unit": "node --test tests/rendered-html.test.mjs tests/chart-engine.test.mjs tests/scenario-engine.test.mjs tests/model-layout.test.mjs tests/data-import.test.mjs tests/ready-data.test.mjs tests/release-artifacts.test.mjs",
    "test": "pnpm typecheck && pnpm lint && pnpm test:unit && pnpm build",
    "rust:fmt": "cargo fmt --manifest-path src-tauri/Cargo.toml -- --check",
    "rust:clippy": "cargo clippy --manifest-path src-tauri/Cargo.toml -- -D warnings",
    "quality": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/quality.ps1",
    "desktop:web:dev": "vite --config vite.desktop.config.ts --port 1420",
    "desktop:web:build": "vite build --config vite.desktop.config.ts",
    "desktop:dev": "scripts\\desktop.cmd dev",
    "desktop:build": "scripts\\desktop.cmd build",
    "release:package": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-release.ps1",
    "desktop:icon": "tauri icon src-tauri/icons/eyes-of-odin-master.png"
  },
  "dependencies": {
    "echarts": "6.1.0",
    "hyparquet": "1.28.1",
    "hyparquet-compressors": "1.1.1",
    "papaparse": "5.5.3",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@tauri-apps/cli": "2.11.0",
    "@types/node": "22.19.19",
    "@types/papaparse": "5.3.16",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "eslint": "9.39.4",
    "typescript": "5.9.3",
    "typescript-eslint": "8.66.0",
    "vite": "8.0.13"
  },
  "type": "module"
}
